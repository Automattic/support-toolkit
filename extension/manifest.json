{
  "manifest_version": 3,
  "name": "Support Toolkit",
  "description": "Productivity toolbar for support agents: live counters, shift timing, reminders, and lightweight stats.",
  "version": "3.2.0",
  "author": "Mauro Pereira",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://schedule.happy.tools/*",
    "https://api.linear.app/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.zendesk.com/*",
        "https://*.zopim.com/*",
        "https://*.zendesk-staging.com/*"
      ],
      "js": [
        "zendesk-selectors.js",
        "customizer-apply.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.zendesk.com/*",
        "https://*.zopim.com/*",
        "https://*.zendesk-staging.com/*"
      ],
      "js": [
        "error-handler.js",
        "config.js",
        "utils.js",
        "constants.js",
        "storage.js",
        "events.js",
        "state.js",
        "notification-utils.js",
        "changelog.js",
        "notifications.js",
        "timers.js",
        "icons.js",
        "ui-helpers.js",
        "theme.js",
        "theme-presets.js",
        "schedule.js",
        "notes.js",
        "transcript.js",
        "linear.js",
        "linear-panel.js",
        "librechat-panel.js",
        "auto-count.js",
        "export.js",
        "timer-manager.js",
        "zd-styling.js",
        "workflow-helper-bridge.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://126740.apps.zdusercontent.com/*"
      ],
      "js": [
        "site-tools-menu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zendesk.com/*",
        "https://*.zopim.com/*",
        "https://*.zendesk-staging.com/*"
      ],
      "js": [
        "workflow-helper.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "sounds/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
